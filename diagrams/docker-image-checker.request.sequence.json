          "rsc",
          "readers"
        ],
        "note": "Follow the authenticated dashboard request into the cached readers."
      },
      {
        "id": "registry-compare",
        "label": "Registry compare",
        "focus": [
          "readers",
          "daemon",
          "hub"
        ],
        "note": "Local digests from the daemon are compared against registry digests."
      },
      {
        "id": "manual-refresh",
        "label": "Manual refresh",
        "focus": [
          "user",
          "rsc",
          "readers"
        ],
        "note": "The refresh button invalidates cache tags and recomputes."
      }
    ]
