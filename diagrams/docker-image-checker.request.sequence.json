  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "Static shell streams data via Suspense",
        "Verdicts compare local vs remote digests"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Unauthenticated requests are redirected to /login",
        "Session lives in an HTTP-only iron-session cookie"
