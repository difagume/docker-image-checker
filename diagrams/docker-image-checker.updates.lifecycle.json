      "col": 2,
      "tag": "terminal"
    },
    {
      "id": "error",
      "type": "failure",
      "label": "Check Failed",
      "sublabel": "registry unreachable",
      "lane": "terminal",
      "col": 0,
      "tag": "retries"
    }
