          "checking",
          "evaluated",
          "available",
          "current"
        ],
        "note": "Follow one image from an unknown state to a concrete verdict."
      },
      {
        "id": "policy-gate",
        "label": "Policy gate",
        "focus": [
          "evaluated",
          "available",
          "suppressed",
          "notifying"
        ],
        "note": "How the semver policy suppresses unwanted updates before notifying."
      },
      {
        "id": "recovery",
        "label": "Failure recovery",
        "focus": [
          "checking",
          "error"
        ],
        "note": "A failed registry check retries on the next cron run."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Check phases"
    },
    {
      "id": "policy",
      "label": "Policy gate"
    },
    {
      "id": "notify",
      "label": "Notifier"
    },
    {
      "id": "terminal",
      "label": "Outcomes"
    }
  ],
  "states": [
    {
      "id": "unknown",
      "type": "start",
      "label": "Unknown",
      "sublabel": "no check yet",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "fresh"
    },
    {
      "id": "checking",
      "type": "active",
      "label": "Checking",
      "sublabel": "registry query",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "running"
    },
    {
      "id": "evaluated",
      "type": "decision",
      "label": "Evaluated",
      "sublabel": "digest diff",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "gate"
    },
    {
      "id": "available",
      "type": "waiting",
      "label": "Update Available",
      "sublabel": "newer remote digest",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "actionable"
    },
    {
      "id": "current",
      "type": "success",
      "label": "Up to Date",
      "sublabel": "digests equal",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "success"
    },
    {
      "id": "suppressed",
      "type": "waiting",
      "label": "Policy Skip",
