  "cards": [
    {
      "dot": "cyan",
      "title": "Check rail",
      "items": [
        "Every tracked image starts unknown until its first registry check",
        "The verdict is a digest comparison, not a tag string match"
      ]
    },
    {
      "dot": "amber",
      "title": "Policy gate",
      "items": [
        "Major bumps and rc/beta tags can be suppressed",
        "Suppressed updates still render, but never alert"
      ]
    },
    {
      "dot": "rose",
      "title": "Outcomes",
      "items": [
        "Notified is the terminal success of the deduped fan-out",
        "A failed check is recoverable: the next cron run retries"
      ]
    }
  ]
